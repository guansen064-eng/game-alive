# 复制为 .env 后务必换成高强度随机密码，不要提交真实密码。
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=alive_game
MYSQL_USER=alive_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3306
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# 使用 HTTPS 后改为 true；仅通过 HTTP 测试时保持 false。
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
API_PORT=3000
